# URL publique du frontend (utilisée pour les liens de confirmation e-mail, reset mot de passe, etc.)
# En production : définir l'URL réelle du site (ex. https://votre-domaine.vercel.app)
FRONTEND_URL=http://localhost:5173

# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Nom historique lu par Backend/utils/supabase.js. Ne jamais copier ce secret dans Frontend/.env.
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Serveur
PORT=5000

# Papi Hosted Checkout : ces valeurs restent exclusivement côté backend.
PAPI_BASE_URL=https://app.papi.mg/engine/api
PAPI_API_KEY=
PAPI_WEBHOOK_SECRET=
# Origine HTTPS publique du backend (ou tunnel HTTPS en développement).
BACKEND_PUBLIC_URL=
# Activer le rattrapage des notifications manquées après la migration SQL.
PAPI_RECONCILE_ENABLED=false
